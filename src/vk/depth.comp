#version 450
// A D24S8 buffer read as an RGBA8 texture, as games do for depth effects:
// the four bytes memory holds, depth low first and stencil last, which an
// RGBA8 texel reads backwards (red the stencil, alpha the lowest byte).

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D depth;
layout(set = 0, binding = 1) uniform usampler2D stencil;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D color;

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, imageSize(color)))) return;
    uint d = uint(round(clamp(texelFetch(depth, at, 0).r, 0.0, 1.0) * 16777215.0));
    uint s = texelFetch(stencil, at, 0).r;
    imageStore(color, at, vec4(float(s), float(d >> 16), float((d >> 8) & 0xFFu), float(d & 0xFFu)) / 255.0);
}
